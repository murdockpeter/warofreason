{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/node.tsbuildinfo"
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "src/domain",
    "src/renderer/env.d.ts",
    "scripts",
    "tests/unit",
    "tests/fixtures",
    "tests/e2e",
    "*.config.ts"
  ]
}
